# PostgreSQL connection string, e.g.
# postgresql://user:password@localhost:5432/surveillance
DATABASE_URL=

# Video source: 0 for default webcam, or a file path / RTSP URL
VIDEO_SOURCE=0

YOLO_MODEL=yolo11n.pt
CONFIDENCE_THRESHOLD=0.5
PROCESSING_FPS=10
CROWD_THRESHOLD=5

# --- Auth ---
# Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
